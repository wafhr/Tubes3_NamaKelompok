{
  "manifest_version": 3,
  "name": "Judol Detector",
  "version": "0.1.0",
  "description": "Mendeteksi konten judi online pada halaman web.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Judol Detector"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["keywords/keyword.txt"],
      "matches": ["<all_urls>"]
    }
  ]
}
